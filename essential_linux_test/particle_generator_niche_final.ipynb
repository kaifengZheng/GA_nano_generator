    "        dist=cdist([parent1[0]],lattice_big)\n",
    "        x=np.where(np.isclose(dist,np.min(dist))[0])[0]\n",
    "        close=np.round(parent1[0]-lattice_big[x],5)\n",
    "        print(f\"shift_A={close[0]}\")\n",
