   "source": [
    "import plotly.graph_objects as go\n",
    "convex_p2,hull,particle=convex_particle(parent2, lattice_big, lc)\n",
    "convex_p1,hull,particle=convex_particle(parent1, lattice_big, lc)\n",
    "xc = particle[hull.vertices]\n",
    "fig = go.Figure()\n",
    "fig.add_trace(go.Scatter3d(x=particle[:, 0], \n",
    "                        y=particle[:, 1], \n",
    "                        z=particle[:, 2], \n",
    "                        mode='markers', \n",
    "                        marker=dict(size=10, color='blue')))\n",
    "fig.add_trace(go.Mesh3d(x=xc[:, 0], \n",
    "                        y=xc[:, 1], \n",
    "                        z=xc[:, 2], \n",
