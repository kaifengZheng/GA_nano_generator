    "def find_most_similar(population, individual, crowding_distance=0.1):\n",
    "    return np.array(\n",
    "        [\n",
    "            min(\n",
    "                population,\n",
    "                key=lambda x: calculate_similarity(x, individual, crowding_distance),\n",
    "            )\n",
    "        ]\n",
    "    )[0]\n",
